rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Only the authenticated user can read/write their own doc
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Progress sub-collection
      match /progress/{lessonId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Activity log sub-collection
      match /activity/{date} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // ── Curriculum (lessons) — read-only for authenticated users ─────────────
    match /curriculum/{lessonId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins via Firebase Admin SDK
    }

    // ── Vocabulary (shared word bank) — read-only ────────────────────────────
    match /vocabulary/{wordId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
